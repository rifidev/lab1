    {
      "name": "Création (POST)",
      "item": [
        {
          "name": "Ajouter produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Vérifier que le statut est 200 ou 201\npm.test(\"Statut de création valide\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Extraire l'ID du produit créé et le stocker dans une variable globale/environnement\nvar jsonData = pm.response.json();\npm.environment.set(\"createdProductId\", jsonData.id);\nconsole.log(\"ID du produit créé : \" + jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Casque Audio Sans Fil\",\n    \"price\": 129.99,\n    \"category\": \"audio\",\n    \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "add"
              ]
            }
          },
          "response": []
        },
        {
          "name": "400 - Corps malformé",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"corps JSON malformé \", function () {\n    pm.response.to.have.status(400);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Casque Audio Sans Fil\"\n    \"price\": \"ERROR\",\n    \"category\": \"audio\",\n    \"stock\": 25\n}",
